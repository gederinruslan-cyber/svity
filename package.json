{
  "name": "svity",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @svity/api --filter @svity/web dev",
    "dev:web": "pnpm --filter @svity/web dev",
    "dev:api": "pnpm --filter @svity/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres mailpit",
    "db:migrate": "pnpm --filter @svity/db migrate",
    "db:generate": "pnpm --filter @svity/db generate",
    "deck:import": "pnpm --filter @svity/db deck:import",
    "user:role": "pnpm --filter @svity/db user:role"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
