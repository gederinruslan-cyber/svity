{
  "name": "svity",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @svity/api --filter @svity/web dev",
    "dev:web": "pnpm --filter @svity/web dev",
    "dev:api": "pnpm --filter @svity/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @svity/db migrate",
    "db:generate": "pnpm --filter @svity/db generate"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
