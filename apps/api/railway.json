{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @svity/api typecheck",
    "watchPatterns": [
      "apps/api/**",
      "packages/**",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "pnpm db:migrate && pnpm deck:import"
    ],
    "startCommand": "pnpm --filter @svity/api start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
